# Yomukai worker: the heavy jobs, on the home server (or the GPU laptop). Connects out to the VPS; exposes nothing.
#   docker compose -f docker-compose.worker.yml up -d
# Engines are optional: the worker announces only the ones it finds installed.
#   WITH_MEDIA   ffmpeg + Chromaprint (downloads to Jellyfin, opening/ending detection)   on by default
#   WITH_OCR     Tesseract with Spanish, English, Japanese, Korean and Chinese              on by default
#   WITH_TTS     Pocket TTS (Kyutai, MIT): natural voices on the CPU                        in the "full" image
#   WITH_WHISPER whisper.cpp (MIT) + the "base" model: subtitles for anime                  in the "full" image
# Published as ghcr.io/nuxx-g/yomukai-worker (light) and ghcr.io/nuxx-g/yomukai-worker-full (all engines).
# Translation (LibreTranslate) runs as its own container: see docker-compose.worker.yml.

FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
ENV YOMUKAI_SERVER_ONLY=true GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.configuration-cache=false"
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle/ gradle/
# GitHub (where Gradle downloads from) sometimes answers 5xx for a moment: a few spaced retries.
RUN for i in 1 2 3 4 5; do ./gradlew --version --console=plain -q && exit 0; sleep $((i * 20)); done; exit 1
COPY shared/ shared/
COPY server/ server/
COPY worker/ worker/
# The build fetches the Java 21 toolchain from GitHub, which sometimes fails for a moment: retried.
RUN for i in 1 2 3; do ./gradlew :worker:installDist --console=plain -q && exit 0; sleep $((i * 30)); done; exit 1

# whisper.cpp, built only when asked (a static binary, no OpenMP), plus the small multilingual model.
FROM ubuntu:24.04 AS whisper
ARG WITH_WHISPER=false
ARG WHISPER_VERSION=v1.9.5
RUN mkdir -p /out/bin /out/models && if [ "$WITH_WHISPER" = "true" ]; then \
      apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates curl \
      && git clone --depth 1 --branch "$WHISPER_VERSION" https://github.com/ggml-org/whisper.cpp /whisper \
      && cmake -S /whisper -B /whisper/build -DBUILD_SHARED_LIBS=OFF -DGGML_OPENMP=OFF -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF \
      && cmake --build /whisper/build --config Release -j"$(nproc)" --target whisper-cli \
      && cp /whisper/build/bin/whisper-cli /out/bin/ \
      && curl -fsSL -o /out/models/ggml-base.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin; \
    fi

FROM eclipse-temurin:25-jre
ARG WITH_MEDIA=true
ARG WITH_OCR=true
ARG WITH_TTS=false
ARG POCKET_TTS_VERSION=4.0.1
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates util-linux \
 && if [ "$WITH_MEDIA" = "true" ]; then apt-get install -y --no-install-recommends ffmpeg libchromaprint-tools; fi \
 && if [ "$WITH_OCR" = "true" ]; then apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
      tesseract-ocr-jpn tesseract-ocr-kor tesseract-ocr-chi-sim; fi \
 && if [ "$WITH_TTS" = "true" ]; then apt-get install -y --no-install-recommends python3 python3-venv; fi \
 && rm -rf /var/lib/apt/lists/*
# Pocket TTS in its own environment, CPU build of PyTorch (no CUDA weight in the image). Its voice model is fetched
# from Hugging Face the first time it speaks, into the worker's home.
RUN if [ "$WITH_TTS" = "true" ]; then \
      python3 -m venv /opt/tts \
      # Each package from one index only (no mixing indexes: no dependency confusion). PyTorch's CPU build first, from
      # PyTorch's own index; then Pocket TTS and the rest from PyPI, where torch is already satisfied.
      && /opt/tts/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
      && /opt/tts/bin/pip install --no-cache-dir --index-url https://pypi.org/simple "pocket-tts==$POCKET_TTS_VERSION" \
      && ln -s /opt/tts/bin/pocket-tts /usr/local/bin/pocket-tts; \
    fi
COPY --from=whisper /out/bin/ /usr/local/bin/
COPY --from=whisper /out/models/ /models/
RUN useradd --system --create-home --uid 10002 worker && mkdir -p /work /backups && chown worker /work /backups
COPY --from=build /src/worker/build/install/worker/ /app/
RUN chmod -R a+rX /app
ENV WORKER_WORK_DIR=/work WORKER_WHISPER_MODEL=/models/ggml-base.bin \
    JAVA_OPTS="-XX:+UseSerialGC -XX:MaxRAMPercentage=40 -XX:+ExitOnOutOfMemoryError"
USER worker
CMD ["/app/bin/worker"]
