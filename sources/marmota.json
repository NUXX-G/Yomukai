{
  "id": "marmota",
  "name": "Marmota Comics",
  "lang": "ES",
  "kind": "manga",
  "types": ["COMIC"],
  "engine": "madara",
  "baseUrl": "https://marmota.me",
  "domains": ["https://marmota.me"],
  "images": { "attrs": ["data-src", "src"], "ignore": ["dflazy"], "forceHttps": true },
  "pages": { "image": ".reading-content img.wp-manga-chapter-img" },
  "browse": {
    "url": "{base}/?s=&post_type=wp-manga&m_orderby={sort}&paged={page}",
    "item": ".c-tabs-item__content",
    "multi": { "status": "&status%5B%5D={value}", "genre": "&genre%5B%5D={value}" }
  },
  "filters": [
    {
      "key": "sort", "label": "Orden",
      "options": [
        { "value": "latest", "label": "Recientes" }, { "value": "trending", "label": "Tendencia" },
        { "value": "views", "label": "Más vistos" }, { "value": "rating", "label": "Mejor valorados" },
        { "value": "new-manga", "label": "Nuevos" }, { "value": "alphabet", "label": "A-Z" }
      ]
    },
    {
      "key": "status", "label": "Estado", "multi": true,
      "options": [
        { "value": "on-going", "label": "En emisión" }, { "value": "end", "label": "Completado" },
        { "value": "canceled", "label": "Cancelado" }, { "value": "on-hold", "label": "En pausa" },
        { "value": "upcoming", "label": "Próximamente" }
      ]
    },
    {
      "key": "genre", "label": "Editorial / colección", "multi": true,
      "options": [
        { "value": "20th-century-studios", "label": "20th Century Studios" }, { "value": "aftershock", "label": "Aftershock" },
        { "value": "archie-comics", "label": "Archie" }, { "value": "black-label", "label": "Black Label" },
        { "value": "boom-studios", "label": "BOOM! Studios" }, { "value": "crossovers", "label": "Crossovers" },
        { "value": "dark-horse", "label": "Dark Horse" }, { "value": "dc-comics", "label": "DC Comics" },
        { "value": "dc-horror", "label": "DC Horror" }, { "value": "dynamite", "label": "Dynamite" },
        { "value": "editorial-awa", "label": "AWA" }, { "value": "europeo", "label": "Europeo" },
        { "value": "eventos-dc", "label": "Eventos DC" }, { "value": "eventos-marvel", "label": "Eventos Marvel" },
        { "value": "idw", "label": "IDW" }, { "value": "image-comics", "label": "Image" }, { "value": "indies", "label": "Indies" },
        { "value": "mad-cave", "label": "Mad Cave" }, { "value": "manga", "label": "Manga" }, { "value": "marvel-comics", "label": "Marvel" },
        { "value": "oni-press", "label": "Oni Press" }, { "value": "rebellion-developments", "label": "Rebellion" },
        { "value": "vertigo", "label": "Vertigo" }, { "value": "virus", "label": "Virus" }, { "value": "zenescope", "label": "Zenescope" }
      ]
    }
  ]
}
