<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The server session never leaves the phone in a backup or a phone-to-phone copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yomukai_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yomukai_sync.xml" />
    </device-transfer>
</data-extraction-rules>
