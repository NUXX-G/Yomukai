<?xml version="1.0" encoding="utf-8"?>
<!-- App icon built from drawable/logo_app (full-bleed artwork). The 12% inset shows the manga
     speed lines around the "Y" while the artwork still covers the whole visible area of every
     launcher mask (circle, squircle, rounded square). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_yomukai_background" />
    <foreground>
        <inset
            android:drawable="@drawable/logo_app"
            android:inset="12%" />
    </foreground>
</adaptive-icon>
