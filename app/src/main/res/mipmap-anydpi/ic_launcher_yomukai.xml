<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: the black circle from drawable/logo_app. The artwork is slightly enlarged
     (negative inset) so the circle covers the whole visible area of every launcher mask and the
     white corners of the JPEG never show; the background is black to match. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_yomukai_background" />
    <foreground>
        <inset
            android:drawable="@drawable/logo_app"
            android:inset="-6%" />
    </foreground>
</adaptive-icon>
